/* Rofi theme. Layout is static; colors come from colors.rasi, which is
   generated by ~/.config/theme/build.sh from the central palette. */
@import "colors.rasi"

* {
    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    width:            600px;
    padding:          0;
}

mainbox { padding: 12px; spacing: 10px; }

inputbar {
    background-color: @bg-alt;
    text-color:       @fg;
    padding:          8px 10px;
    children:         [ prompt, entry ];
    spacing:          8px;
}
prompt { text-color: @accent; }
entry  { placeholder: "Search…"; placeholder-color: @muted; }

listview { lines: 8; spacing: 4px; scrollbar: false; }

element { padding: 6px 8px; }
element selected {
    background-color: @accent;
    text-color:       @bg;
}
element-text { background-color: transparent; text-color: inherit; }
element-icon { background-color: transparent; size: 1.1em; }
