#!/usr/bin/env bash
# autorandr postswitch hook -- runs after a display change (dock/undock/hotplug).
#
# Workspace rule:
#   1-3 -> external (HDMI-1 or DP-1) when present, else laptop
#   4-6 -> laptop (eDP-1)
#
# i3's "workspace output" directives already assign workspaces and collapse them
# onto eDP-1 when the external disconnects. The one thing i3 won't do is move
# 1-3 BACK to the external on replug -- that's the job below. We only move
# workspaces that actually exist, so no empty placeholders get created.
set -uo pipefail

command -v i3-msg >/dev/null || exit 0
command -v xrandr >/dev/null || exit 0
command -v jq     >/dev/null || exit 0

INT="eDP-1"
EXT="$INT"
# NB: "connected" may be followed by "primary" before the geometry.
if   xrandr | grep -qE "^HDMI-1 connected (primary )?[0-9]"; then EXT="HDMI-1"
elif xrandr | grep -qE "^DP-1 connected (primary )?[0-9]";   then EXT="DP-1"
fi

# Remember focus so re-pinning doesn't yank the user to another workspace.
focused=$(i3-msg -t get_workspaces | jq -r '.[] | select(.focused).num')

i3-msg -t get_workspaces | jq -r '.[].num' | while read -r n; do
  case "$n" in
    1|2|3) tgt="$EXT" ;;
    4|5|6) tgt="$INT" ;;
    *)     continue ;;
  esac
  i3-msg "workspace number $n; move workspace to output $tgt" >/dev/null
done

[ -n "$focused" ] && i3-msg "workspace number $focused" >/dev/null

# Re-map the touchscreen to the laptop panel. Its coordinate matrix is
# relative to the whole virtual desktop, so it goes stale whenever the
# layout changes and touches land offset from the finger.
command -v xinput >/dev/null && \
  xinput map-to-output "ELAN900C:00 04F3:2F59" "$INT" 2>/dev/null || true

# Reapply wallpaper: a layout change resizes the root window and feh's old
# pixmap gets tiled across it otherwise.
command -v feh >/dev/null && feh --bg-fill "$HOME/Pictures/Wallpapers/wallpaper.jpg" >/dev/null 2>&1 || true

# Relaunch polybar so a bar spawns on every currently-active monitor.
[ -x "$HOME/.config/polybar/launch.sh" ] && "$HOME/.config/polybar/launch.sh" >/dev/null 2>&1 &
